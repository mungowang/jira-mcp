{
  "tools": {
    "jira_scriptrunner_run": {
      "desc": "Run a ScriptRunner custom endpoint",
      "params": {
        "name": {
          "type": "string",
          "describe": "ScriptRunner endpoint name - the last path segment, without a leading slash"
        },
        "payload": {
          "type": "object",
          "describe": "JSON body sent to the endpoint; omit it when the endpoint takes no input"
        }
      },
      "required": [
        "name"
      ],
      "method": "POST",
      "path": "/rest/scriptrunner/latest/custom/{name}",
      "body": "{payload}",
      "returns": "anyObject"
    },
    "jira_jsm_queues": {
      "desc": "List Jira Service Management queues",
      "readOnly": true,
      "params": {
        "serviceDeskId": "numericId"
      },
      "required": [
        "serviceDeskId"
      ],
      "method": "GET",
      "path": "/rest/servicedeskapi/servicedesk/{serviceDeskId}/queue",
      "returns": "paged"
    }
  }
}